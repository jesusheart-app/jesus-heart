rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 회원 본인의 회원 문서만 읽을 수 있습니다.
    match /appdata/member:{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending';
      // 승인/차단 상태 변경은 추후 관리자 권한으로만 허용합니다.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == resource.data.status;
      allow delete: if false;
    }

    // 승인된 교인만 공동체 데이터를 읽고 쓸 수 있습니다.
    match /appdata/{docId} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/appdata/member:$(request.auth.uid))
        && get(/databases/$(database)/documents/appdata/member:$(request.auth.uid)).data.status == 'approved';
    }
  }
}
