rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 회원 문서: 본인 문서만 접근. 가입 직후에는 pending 상태만 생성 가능.
    match /appdata/{docId} {
      allow create: if request.auth != null
        && docId == 'member:' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if request.auth != null
        && docId == 'member:' + request.auth.uid;

      allow update: if request.auth != null
        && docId == 'member:' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == resource.data.status;

      // 관리자 승인 기능을 만들기 전까지 회원 문서는 삭제하지 않습니다.
      allow delete: if false;

      // 승인된 교인만 공동체 데이터에 접근할 수 있습니다.
      allow read, write: if request.auth != null
        && docId != 'member:' + request.auth.uid
        && exists(/databases/$(database)/documents/appdata/member:$(request.auth.uid))
        && get(/databases/$(database)/documents/appdata/member:$(request.auth.uid)).data.status == 'approved';
    }
  }
}
